<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep old /public URLs working, but redirect visitors to clean URLs.
    RewriteCond %{THE_REQUEST} \s/+public/?([^\s?]*) [NC]
    RewriteRule ^public/?(.*)$ /$1 [R=301,L,NE]

    # Serve the Laravel public directory without showing /public in the URL.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
